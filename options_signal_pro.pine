//@version=6
indicator("Options Signal Enterprise PRO [Antigravity]", overlay=true, max_labels_count=500, max_lines_count=500)

// ==========================================
// --- INPUTS ---
// ==========================================
grp_mtf = "🌐 Multi-Timeframe Analysis"
use_mtf = input.bool(true, "Use MTF Trend Confirmation", group=grp_mtf)
mtf_res = input.timeframe("D", "Higher Timeframe Resolution", group=grp_mtf)

grp_signals = "⚡ Signal Sensitivity"
st_atr_len = input.int(10, "SuperTrend ATR Length", group=grp_signals)
st_factor  = input.float(3.0, "SuperTrend Factor", step=0.1, group=grp_signals)
rsi_len    = input.int(14, "RSI Length", group=grp_signals)

grp_filters = "🏦 Institutional Flow (VFI)"
vfi_len   = input.int(130, "VFI Length", group=grp_filters)
vfi_coef  = input.float(0.2, "VFI Coefficient", step=0.05, group=grp_filters)
vfi_vcoef = input.float(2.5, "VFI Vol Coefficient", step=0.1, group=grp_filters)

grp_vol = "🌪️ Volatility & Squeeze"
use_squeeze = input.bool(true, "Squeeze Filter (Avoid Chop)", group=grp_vol)

grp_risk = "💰 Risk Management"
atr_len      = input.int(14, "ATR Period", group=grp_risk)
sl_atr_mult  = input.float(1.5, "Stop Loss ATR Mult", step=0.1, group=grp_risk)
tp1_atr_mult = input.float(1.2, "TP 1 ATR Mult", step=0.1, group=grp_risk)
tp2_atr_mult = input.float(2.5, "TP 2 ATR Mult", step=0.1, group=grp_risk)

// ==========================================
// --- CALCULATIONS ---
// ==========================================

// 1. Multi-Timeframe Bias
float mtf_close = request.security(syminfo.tickerid, mtf_res, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
float mtf_ema   = request.security(syminfo.tickerid, mtf_res, ta.ema(close, 50), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
mtf_bullish     = not use_mtf or mtf_close > mtf_ema

// 2. Volume Flow Index (VFI) - Institutional Tracking
vfi_calc(len, coef, vcoef) =>
    float _vfi = 0.0
    float _typical = (high + low + close) / 3
    float _inter = math.log(_typical) - math.log(_typical[1])
    float _vave = ta.sma(volume, len)[1]
    float _vmax = _vave * vcoef
    float _vc = math.min(volume, _vmax)
    float _mff = _typical - _typical[1]
    float _v_cutoff = coef * ta.stdev(_inter, 30) * _typical
    float _v_curr = _mff > _v_cutoff ? _vc : _mff < -_v_cutoff ? -_vc : 0
    _vfi := ta.sma(ta.cum(_v_curr), len) / _vave
    _vfi

vfi_val = vfi_calc(vfi_len, vfi_coef, vfi_vcoef)
vfi_bullish = vfi_val > 0

// 3. TTM Squeeze Logics
bb_upper = ta.sma(close, 20) + 2.0 * ta.stdev(close, 20)
bb_lower = ta.sma(close, 20) - 2.0 * ta.stdev(close, 20)
kc_upper = ta.sma(close, 20) + 1.5 * ta.atr(20)
kc_lower = ta.sma(close, 20) - 1.5 * ta.atr(20)
is_squeeze = bb_upper < kc_upper and bb_lower > kc_lower
no_squeeze = not use_squeeze or not is_squeeze

// 4. Core Indicators
[st_val, st_dir] = ta.supertrend(st_factor, st_atr_len)
st_buy  = st_dir < 0
st_sell = st_dir > 0
rsi     = ta.rsi(close, rsi_len)
ema50   = ta.ema(close, 50)
vol_ma  = ta.sma(volume, 20)

// ==========================================
// --- SIGNAL LOGIC ---
// ==========================================

// Baseline Triggers
buy_trigger  = ta.change(st_dir) < 0 and no_squeeze
sell_trigger = ta.change(st_dir) > 0 and no_squeeze

// Professional Signal Classification
buy_signal   = buy_trigger and close > ema50
sell_signal  = sell_trigger and close < ema50

// Strong (Enterprise) Signals
strong_buy   = buy_signal and vfi_bullish and mtf_bullish and rsi > 55 and volume > vol_ma
strong_sell  = sell_signal and not vfi_bullish and not mtf_bullish and rsi < 45 and volume > vol_ma

// Extraction for real-time consistency
buy_ch   = ta.change(buy_signal)
sell_ch  = ta.change(sell_signal)
s_buy_ch = ta.change(strong_buy)
s_sell_ch= ta.change(strong_sell)

// --- ATR-BASED DYNAMIC TARGETS ---
atr = ta.atr(atr_len)
var float sl_lvl = na
var float tp1_lvl = na
var float tp2_lvl = na

if (buy_ch > 0 or s_buy_ch > 0)
    sl_lvl  := low - (atr * sl_atr_mult)
    tp1_lvl := close + (atr * tp1_atr_mult)
    tp2_lvl := close + (atr * tp2_atr_mult)

if (sell_ch > 0 or s_sell_ch > 0)
    sl_lvl  := high + (atr * sl_atr_mult)
    tp1_lvl := close - (atr * tp1_atr_mult)
    tp2_lvl := close - (atr * tp2_atr_mult)

// ==========================================
// --- VISUAL ARCHITECTURE ---
// ==========================================

// Trade Line (EMA 50)
plot(ema50, "Trade Line (EMA 50)", color=st_buy ? color.green : color.red, linewidth=3)

// Background Trend Zone
bgcolor(st_buy ? color.new(color.green, 96) : color.new(color.red, 96))

// Professional Label Management (Anti-Flicker)
var label sig_label = na
if barstate.isrealtime and not barstate.isconfirmed
    label.delete(sig_label)

// Signal Labels
if (s_buy_ch > 0)
    sig_label := label.new(bar_index, low, "💎 STRONG BUY", color=color.new(color.aqua, 0), textcolor=color.black, style=label.style_label_up, yloc=yloc.belowbar, size=size.normal)
    alert("Strong Buy Signal!", alert.freq_once_per_bar_close)
else if (buy_ch > 0)
    sig_label := label.new(bar_index, low, "BUY", color=color.new(color.green, 0), textcolor=color.white, style=label.style_label_up, yloc=yloc.belowbar, size=size.small)

if (s_sell_ch > 0)
    sig_label := label.new(bar_index, high, "💀 STRONG SELL", color=color.new(color.orange, 0), textcolor=color.black, style=label.style_label_down, yloc=yloc.abovebar, size=size.normal)
    alert("Strong Sell Signal!", alert.freq_once_per_bar_close)
else if (sell_ch > 0)
    sig_label := label.new(bar_index, high, "SELL", color=color.new(color.red, 0), textcolor=color.white, style=label.style_label_down, yloc=yloc.abovebar, size=size.small)

// Dynamic Target Plots
plot(sl_lvl, "Stop Loss", color=color.new(color.red, 40), style=plot.style_linebr, linewidth=1)
plot(tp1_lvl, "TP 1", color=color.new(color.lime, 40), style=plot.style_linebr, linewidth=1)
plot(tp2_lvl, "TP 2 (Major)", color=color.new(color.green, 20), style=plot.style_linebr, linewidth=2)

// ==========================================
// --- ENTERPRISE DASHBOARD ---
// ==========================================
var table board = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 40), border_width=1, border_color=color.gray)
if (barstate.islast)
    // Header
    table.cell(board, 0, 0, "Enterprise PRO Metrics", text_color=color.white, text_size=size.small)
    table.cell(board, 1, 0, "Status", text_color=color.white, text_size=size.small)
    
    // MTF
    table.cell(board, 0, 1, "HTF Trend (" + mtf_res + ")", text_color=color.white)
    table.cell(board, 1, 1, mtf_bullish ? "BULLISH" : "BEARISH", text_color=mtf_bullish?color.green:color.red)
    
    // Institutional Flow
    table.cell(board, 0, 2, "Inst. Flow (VFI)", text_color=color.white)
    table.cell(board, 1, 2, vfi_bullish ? "INFLOW" : "OUTFLOW", text_color=vfi_bullish?color.aqua:color.orange)
    
    // Momentum
    table.cell(board, 0, 3, "Momentum (RSI)", text_color=color.white)
    table.cell(board, 1, 3, str.format("{0,number,#.##}", rsi), text_color=rsi > 50 ? color.green : color.red)

    // Volatility
    table.cell(board, 0, 4, "Squeeze State", text_color=color.white)
    table.cell(board, 1, 4, is_squeeze ? "COMPRESSION" : "EXPANSION", text_color=is_squeeze?color.yellow:color.lime)
    
    // Current Target
    table.cell(board, 0, 5, "Major Target (TP2)", text_color=color.white)
    table.cell(board, 1, 5, str.format("{0,number,#.##}", tp2_lvl), text_color=color.green)

// Confirmation for Real-Time Execution
if barstate.isconfirmed
    if (buy_ch > 0 or sell_ch > 0)
        label.new(bar_index, low, "CONFIRMED", color=color.new(color.aqua, 20), size=size.tiny, style=label.style_label_up, yloc=yloc.belowbar)
