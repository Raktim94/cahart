//@version=6
indicator("GOLDEN OPTIONS PRO [Ultra-Reliable]", overlay=true, max_labels_count=500, max_lines_count=500)

// ==========================================
// --- INPUTS ---
// ==========================================
grp1 = "⚡ Strategy Settings"
st_atr_len = input.int(10, "SuperTrend Period", minval=1, group=grp1)
st_factor  = input.float(3.0, "SuperTrend Factor", minval=0.1, step=0.1, group=grp1)
rsi_limit  = input.int(50, "Momentum Threshold (RSI)", group=grp1)

grp2 = "📈 Trade Lines (EMAs)"
ema_fast = input.int(9, "Fast Line", group=grp2)
ema_med  = input.int(50, "Trade Line (EMA 50)", group=grp2)
ema_slow = input.int(200, "Market Bias (EMA 200)", group=grp2)

grp3 = "💰 Profit & Risk"
atr_len = input.int(14, "ATR Period", group=grp3)
sl_mult = input.float(1.5, "Stop Loss ATR Mult", step=0.1, group=grp3)
tp_mult = input.float(2.0, "Take Profit ATR Mult", step=0.1, group=grp3)

// ==========================================
// --- CALCULATIONS ---
// ==========================================
// Indicators (Calculated on every bar)
ema9   = ta.ema(close, ema_fast)
ema50  = ta.ema(close, ema_med)
ema200 = ta.ema(close, ema_slow)
rsi    = ta.rsi(close, 14)
atr    = ta.atr(atr_len)
vol_ma = ta.sma(volume, 20)

// SuperTrend
[st_val, st_dir] = ta.supertrend(st_factor, st_atr_len)
st_buy  = st_dir < 0
st_sell = st_dir > 0

// Trigger detections (Global scope for consistency)
buy_cross    = ta.change(st_dir) < 0
sell_cross   = ta.change(st_dir) > 0

// ==========================================
// --- SIGNAL LOGIC ---
// ==========================================
// Primary Confirmation
bullish_market = close > ema200
bearish_market = close < ema200

// BUY SIGNALS
buy_signal   = buy_cross and close > ema50 and rsi > rsi_limit
strong_buy   = buy_signal and bullish_market and volume > vol_ma and rsi > 60

// SELL SIGNALS
sell_signal  = sell_cross and close < ema50 and rsi < rsi_limit
strong_sell  = sell_signal and bearish_market and volume > vol_ma and rsi < 40

// --- ATR TARGETS ---
var float sl_price = na
var float tp_price = na

if (buy_signal or strong_buy)
    sl_price := low - (atr * sl_mult)
    tp_price := close + (atr * tp_mult)

if (sell_signal or strong_sell)
    sl_price := high + (atr * sl_mult)
    tp_price := close - (atr * tp_mult)

// ==========================================
// --- VISUALS ---
// ==========================================
// Plot Trade Lines
plot(ema9, "EMA 9", color=color.new(color.aqua, 60))
plot(ema50, "Trade Line (EMA 50)", color=st_buy ? color.green : color.red, linewidth=3)
plot(ema200, "EMA 200", color=color.new(color.white, 30), linewidth=1)

// Background color for easy trend identification
bgcolor(st_buy ? color.new(color.green, 95) : color.new(color.red, 95))

// Signal Management for Real-Time Charts (Prevents flickering)
var label signal_label = na
if barstate.isrealtime and not barstate.isconfirmed
    label.delete(signal_label)

// Display Labels
if (strong_buy)
    signal_label := label.new(bar_index, low, "� STRONG BUY", color=color.green, textcolor=color.black, style=label.style_label_up, yloc=yloc.belowbar)
    alert("Strong Buy Opportunity!", alert.freq_once_per_bar_close)
else if (buy_signal)
    signal_label := label.new(bar_index, low, "BUY", color=color.lime, textcolor=color.black, style=label.style_label_up, yloc=yloc.belowbar)
    alert("Buy Signal!", alert.freq_once_per_bar_close)

if (strong_sell)
    signal_label := label.new(bar_index, high, "� STRONG SELL", color=color.red, textcolor=color.white, style=label.style_label_down, yloc=yloc.abovebar)
    alert("Strong Sell Opportunity!", alert.freq_once_per_bar_close)
else if (sell_signal)
    signal_label := label.new(bar_index, high, "SELL", color=color.maroon, textcolor=color.white, style=label.style_label_down, yloc=yloc.abovebar)
    alert("Sell Signal!", alert.freq_once_per_bar_close)

// Targets
plot(sl_price, "Stop Loss", color=color.new(color.red, 50), style=plot.style_linebr)
plot(tp_price, "Take Profit", color=color.new(color.green, 50), style=plot.style_linebr)

// ==========================================
// --- DASHBOARD ---
// ==========================================
var table dash = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 40), border_width=1, border_color=color.gray)
if (barstate.islast)
    // Simple, informative headers
    table.cell(dash, 0, 0, "Trade Health", text_color=color.white)
    table.cell(dash, 1, 0, "Value", text_color=color.white)
    
    table.cell(dash, 0, 1, "Market Trend", text_color=color.white)
    table.cell(dash, 1, 1, bullish_market ? "BULLISH" : bearish_market ? "BEARISH" : "NEUTRAL", text_color=bullish_market ? color.green : bearish_market ? color.red : color.gray)
    
    table.cell(dash, 0, 2, "Momentum", text_color=color.white)
    table.cell(dash, 1, 2, str.format("{0,number,#.##}", rsi), text_color=rsi > 50 ? color.green : color.red)
    
    table.cell(dash, 0, 3, "Profit Target", text_color=color.white)
    table.cell(dash, 1, 3, str.format("{0,number,#.##}", tp_price), text_color=color.aqua)
