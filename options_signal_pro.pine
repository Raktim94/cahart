//@version=6
indicator("Options Signal Enterprise PRO [Antigravity]", overlay=true, max_labels_count=500, max_lines_count=500)

// ==========================================
// --- INPUTS ---
// ==========================================
grp_vis = "📺 Visual Management"
show_sr     = input.bool(false, "Show S/R Zones (Clutter)", group=grp_vis)
show_dash   = input.bool(false, "Show Dashboard", group=grp_vis)
large_sig   = input.bool(true, "High-Contrast Labels", group=grp_vis)

grp_signals = "⚡ Signal Accuracy & Speed"
fast_mode  = input.bool(true, "🚀 Fast Response (Zero-Lag)", group=grp_signals)
sr_filter   = input.bool(true, "🛡️ Zone Rejection Filter", group=grp_signals)
mtf_filter  = input.bool(true, "🌐 Higher Timeframe Confirmation", group=grp_signals)

grp_params  = "⚙️ Algorithm Tuning"
st_factor  = input.float(1.5, "Sensitivity Factor", step=0.1, group=grp_params)
vfi_len    = input.int(30, "Volume Flow Period", group=grp_params)
sr_pivot   = input.int(5, "Zone Lookback", group=grp_params)

// Hidden/Internal Defaults
atr_len = 10
st_atr_len = 7
rsi_len = 7
ema_fast = 20
mtf_res = input.timeframe("D", "HTF Reference", group="⚙️ Algorithm Tuning")

// ==========================================
// --- CORE CALCULATIONS ---
// ==========================================

// 1. High-Speed Trend (SuperTrend)
[st_val, st_dir] = ta.supertrend(st_factor, st_atr_len)
st_buy  = st_dir < 0
st_sell = st_dir > 0

// 2. Momentum & Institutional Flow
rsi = ta.rsi(close, rsi_len)
vfi_calc(len) =>
    float _typical = (high + low + close) / 3
    float _inter = math.log(_typical) - math.log(nz(_typical[1], _typical))
    float _vave = ta.sma(volume, len)[1]
    float _vmax = _vave * 2.5
    float _vc = math.min(volume, _vmax)
    float _mff = _typical - nz(_typical[1], _typical)
    float _v_cutoff = 0.2 * ta.stdev(_inter, 30) * _typical
    float _v_curr = _mff > _v_cutoff ? _vc : _mff < -_v_cutoff ? -_vc : 0
    ta.sma(ta.cum(_v_curr), len) / nz(_vave, 1)

vfi_val = vfi_calc(vfi_len)
vfi_bullish = vfi_val > 0

// 3. Multi-Timeframe Bias
float mtf_close = request.security(syminfo.tickerid, mtf_res, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
float mtf_ema   = request.security(syminfo.tickerid, mtf_res, ta.ema(close, 20), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
mtf_bullish     = not mtf_filter or mtf_close > mtf_ema

// 4. S/R Zone Logic (Optimized for Filtering)
ph = ta.pivothigh(high, sr_pivot, sr_pivot)
pl = ta.pivotlow(low, sr_pivot, sr_pivot)
var float resistance = na
var float support = na
if not na(ph)
    resistance := ph
if not na(pl)
    support := pl

near_resistance = close > resistance - (5 * syminfo.mintick)
near_support = close < support + (5 * syminfo.mintick)

// Visualizing S/R (Only if enabled)
if show_sr and barstate.islast
    var box r_zone = box.new(bar_index-50, resistance + (5 * syminfo.mintick), bar_index, resistance - (5 * syminfo.mintick), bgcolor=color.new(color.red, 90), border_color=na)
    var box s_zone = box.new(bar_index-50, support + (5 * syminfo.mintick), bar_index, support - (5 * syminfo.mintick), bgcolor=color.new(color.green, 90), border_color=na)
    box.set_lefttop(r_zone, bar_index-50, resistance + (5 * syminfo.mintick))
    box.set_rightbottom(r_zone, bar_index, resistance - (5 * syminfo.mintick))
    box.set_lefttop(s_zone, bar_index-50, support + (5 * syminfo.mintick))
    box.set_rightbottom(s_zone, bar_index, support - (5 * syminfo.mintick))

// ==========================================
// --- ACCURACY SIGNAL ENGINE ---
// ==========================================

// Merged Condition for Maximum Accuracy
buy_ready  = ta.change(st_dir) < 0 and (not sr_filter or not near_resistance) and mtf_bullish and vfi_bullish
sell_ready = ta.change(st_dir) > 0 and (not sr_filter or not near_support) and not mtf_bullish and not vfi_bullish

// High Probability Signal Triggers
buy_signal  = buy_ready and rsi > 50
sell_signal = sell_ready and rsi < 50

// Detect Change
buy_ch  = buy_signal and not buy_signal[1]
sell_ch = sell_signal and not sell_signal[1]

// ==========================================
// --- LABEL MANAGEMENT (REAL-TIME) ---
// ==========================================
var label rt_label = na

if buy_ch or sell_ch
    string txt = buy_ch ? "🚀 BUY" : "💀 SELL"
    color clr  = buy_ch ? color.new(color.lime, 0) : color.new(color.red, 0)
    color tclr = color.white
    yl = buy_ch ? yloc.belowbar : yloc.abovebar
    styl = buy_ch ? label.style_label_up : label.style_label_down
    sz = large_sig ? size.normal : size.small
    
    if barstate.isconfirmed
        label.new(bar_index, yl == yloc.belowbar ? low : high, txt, color=clr, textcolor=tclr, style=styl, yloc=yl, size=sz)
        alert(txt + " Signal Detected!", alert.freq_once_per_bar_close)
    else
        // Instant Real-Time feedback
        if na(rt_label) or label.get_x(rt_label) != bar_index
            rt_label := label.new(bar_index, yl == yloc.belowbar ? low : high, txt, color=clr, textcolor=tclr, style=styl, yloc=yl, size=sz)
        else
            label.set_xy(rt_label, bar_index, yl == yloc.belowbar ? low : high)
            label.set_text(rt_label, txt)
else
    // Clear if signal vanishes on current tick
    if not barstate.isconfirmed and not na(rt_label) and label.get_x(rt_label) == bar_index
        label.delete(rt_label)
        rt_label := na

// ==========================================
// --- MINIMALIST UI ---
// ==========================================

// Clean EMA Line
plot(ta.ema(close, ema_fast), "Trend Line", color=st_buy ? color.new(color.lime, 40) : color.new(color.red, 40), linewidth=2)

// Dashboard (Only if enabled)
if (show_dash and barstate.islast)
    var table board = table.new(position.top_right, 2, 1, bgcolor=color.new(color.black, 40), border_width=1, border_color=color.gray)
    status_txt = "Trend: " + (st_buy ? "BULL" : "BEAR") + " | Flow: " + (vfi_bullish ? "IN" : "OUT")
    table.cell(board, 0, 0, "Enterprise PRO Status", text_color=color.white, text_size=size.small)
    table.cell(board, 1, 0, status_txt, text_color=st_buy ? color.lime : color.red, text_size=size.small)

// Background Trend (Subtle)
bgcolor(st_buy ? color.new(color.green, 98) : color.new(color.red, 98))
