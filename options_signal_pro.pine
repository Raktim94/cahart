//@version=6
indicator("High Profit Options Signal - Pro", overlay=true, max_labels_count=500, max_lines_count=500)

// --- INPUTS ---
grp_trend = "Trend Identification (Hull Suite)"
hull_len  = input.int(55, "Hull Length", minval=1, group=grp_trend)
hull_mult = input.float(1.0, "Hull Multiplier", minval=0.1, step=0.1, group=grp_trend)

grp_momentum = "Momentum & Volume"
rsi_len = input.int(14, "RSI Length", group=grp_momentum)
rsi_limit_long = input.int(50, "Buy Signal RSI Minimum", group=grp_momentum)
rsi_limit_short = input.int(50, "Sell Signal RSI Maximum", group=grp_momentum)
vol_len = input.int(20, "Volume SMA Length", group=grp_momentum)

grp_risk = "Risk Management (ATR Targets)"
atr_len      = input.int(14, "ATR Length", group=grp_risk)
atr_mult_sl  = input.float(1.5, "Stop Loss Multiplier", step=0.1, group=grp_risk)
atr_mult_tp1 = input.float(1.1, "Take Profit 1 Multiplier", step=0.1, group=grp_risk)
atr_mult_tp2 = input.float(2.2, "Take Profit 2 Multiplier", step=0.1, group=grp_risk)

// --- CALCULATIONS ---
// Hull Moving Average Suite (Fast & Smooth)
hull_ma(src, len) =>
    ta.wma(2 * ta.wma(src, len / 2) - ta.wma(src, len), math.round(math.sqrt(len)))

hma = hull_ma(close, math.round(hull_len * hull_mult))
hma_prev = hma[1]

// Momentum & Volume
rsi = ta.rsi(close, rsi_len)
vol_sma = ta.sma(volume, vol_len)
vol_bullish = volume > vol_sma
rsi_bullish = rsi > rsi_limit_long
rsi_bearish = rsi < rsi_limit_short

// Trend Direction
trend_up = hma > hma_prev
trend_dn = hma < hma_prev

// --- SIGNAL LOGIC ---
// Core Triggers (Pullback + Momentum alignment)
buy_trigger  = trend_up and rsi_bullish and close > hma
sell_trigger = trend_dn and rsi_bearish and close < hma

// Strong Signals (Volume + Trend Strength)
strong_buy  = buy_trigger and vol_bullish and trend_up[1] and rsi > 60
strong_sell = sell_trigger and vol_bullish and trend_dn[1] and rsi < 40

// --- ATR-BASED TARGETS ---
atr = ta.atr(atr_len)
var float sl_price = na
var float tp1_price = na
var float tp2_price = na

if (ta.change(buy_trigger) > 0 or ta.change(strong_buy) > 0)
    sl_price  := low - (atr * atr_mult_sl)
    tp1_price := close + (atr * atr_mult_tp1)
    tp2_price := close + (atr * atr_mult_tp2)

if (ta.change(sell_trigger) > 0 or ta.change(strong_sell) > 0)
    sl_price  := high + (atr * atr_mult_sl)
    tp1_price := close - (atr * atr_mult_tp1)
    tp2_price := close - (atr * atr_mult_tp2)

// --- VISUALS ---
// Plot Trend Line (The "Path")
hma_color = trend_up ? color.green : color.red
plot(hma, "Trend Line", color=color.new(hma_color, 20), linewidth=3)

// Background Fill for Trend
bgcolor(trend_up ? color.new(color.green, 95) : color.new(color.red, 95))

// Signal Management for Real-Time Charts
var label trigger_label = na

// Clear labels on current bar if they aren't confirmed yet (to prevent flickering duplicates)
if barstate.isrealtime and not barstate.isconfirmed
    label.delete(trigger_label)

if (ta.change(strong_buy) > 0)
    trigger_label := label.new(bar_index, low, "🚀 STRONG BUY", color=color.green, textcolor=color.black, style=label.style_label_up, yloc=yloc.belowbar)
    if barstate.isconfirmed
        alert("Strong Buy Signal!", alert.freq_once_per_bar_close)
else if (ta.change(buy_trigger) > 0)
    trigger_label := label.new(bar_index, low, "BUY", color=color.lime, textcolor=color.black, style=label.style_label_up, yloc=yloc.belowbar)
    if barstate.isconfirmed
        alert("Buy Signal!", alert.freq_once_per_bar_close)

if (ta.change(strong_sell) > 0)
    trigger_label := label.new(bar_index, high, "💀 STRONG SELL", color=color.red, textcolor=color.white, style=label.style_label_down, yloc=yloc.abovebar)
    if barstate.isconfirmed
        alert("Strong Sell Signal!", alert.freq_once_per_bar_close)
else if (ta.change(sell_trigger) > 0)
    trigger_label := label.new(bar_index, high, "SELL", color=color.maroon, textcolor=color.white, style=label.style_label_down, yloc=yloc.abovebar)
    if barstate.isconfirmed
        alert("Sell Signal!", alert.freq_once_per_bar_close)

// Plot Target Lines (Live Update for current trade)
plot(sl_price, "Stop Loss", color=color.new(color.red, 40), style=plot.style_linebr, linewidth=1)
plot(tp1_price, "TP 1", color=color.new(color.green, 40), style=plot.style_linebr, linewidth=1)
plot(tp2_price, "TP 2", color=color.new(color.aqua, 20), style=plot.style_linebr, linewidth=2)

// --- DASHBOARD ---
var table panel = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 40), border_width=1, border_color=color.gray)
if (barstate.islast)
    // Headers
    table.cell(panel, 0, 0, "Trade Metrics", text_color=color.white)
    table.cell(panel, 1, 0, "Status", text_color=color.white)
    
    // Trend
    table.cell(panel, 0, 1, "Market Trend", text_color=color.white)
    table.cell(panel, 1, 1, trend_up ? "BULLISH" : "BEARISH", text_color=trend_up?color.green:color.red)
    
    // Momentum
    table.cell(panel, 0, 2, "Momentum (RSI)", text_color=color.white)
    table.cell(panel, 1, 2, str.format("{0,number,#.##}", rsi), text_color=rsi > 50 ? color.green : color.red)
    
    // Volume
    table.cell(panel, 0, 3, "Volume Power", text_color=color.white)
    table.cell(panel, 1, 3, vol_bullish ? "HIGH" : "LOW", text_color=vol_bullish?color.aqua:color.gray)
    
    // Profit Targets
    table.cell(panel, 0, 4, "Profit Goal (TP2)", text_color=color.white)
    table.cell(panel, 1, 4, str.format("{0,number,#.##}", tp2_price), text_color=color.green)

// --- LIVE BAR CONFIRMATION ---
// Ensures no repainting alerts
if barstate.isconfirmed
    if (ta.change(buy_trigger) > 0 or ta.change(sell_trigger) > 0)
        label.new(bar_index, low, "CONFIRMED", color=color.aqua, size=size.tiny, style=label.style_label_up, yloc=yloc.belowbar)
